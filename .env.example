# Copy to .env and fill in. Never commit the real file.

# Required for the LLM agent. Without it /chat falls back to a deterministic
# keyword search so the payment flow can still be demoed.
OPENAI_API_KEY=
# Defaults to gpt-4o. gpt-4o-mini works but follows the agent instructions
# noticeably less reliably -- see the note in agent.py.
OPENAI_MODEL=

# Razorpay test-mode keys. Leave BOTH blank to run in mock payment mode:
# the app then issues fake plink_MOCK_... links and lets the UI drive status.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
